{
  "name": "The Mugumo Valley",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Mugumo Valley app",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "runServices": ["app"]
}
