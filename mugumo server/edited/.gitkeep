<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Page Not Found</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #143d2b;
      color: #fff;
      font-family: Arial, sans-serif;
      text-align: center;
    }
    .box {
      background: rgba(255,255,255,0.08);
      padding: 40px 30px;
      border-radius: 16px;
      max-width: 540px;
    }
    h1 { font-size: clamp(38px, 8vw, 72px); margin-bottom: 10px; }
    p { font-size: 18px; margin-bottom: 20px; }
    a {
      display: inline-block;
      padding: 12px 20px;
      background: #c8a45d;
      color: #111;
      border-radius: 999px;
      text-decoration: none;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>404</h1>
    <p>The page you are looking for does not exist.</p>
    <a href="/">Return Home</a>
  </div>
</body>
</html>
